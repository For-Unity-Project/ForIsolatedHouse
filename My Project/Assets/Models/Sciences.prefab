  m_Script: {fileID: 11500000, guid: 79704913ebfe41a4a81f92e3e4ca1af0, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::DialoguNow2
  dialogueText: {fileID: 5242587921451812656}
  lines:
  - That is correct!, Because On a steep slope, gravity creates a force pulling the
    object downward, making it harder to control and slowing progress.
  - On the other hand, On a flat surface, most of the applied force is used to move
    the object forward, making movement faster and more efficient.
  textSpeed: 0.04
